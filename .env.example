# =============================================================================
# LLDAP User Signup — environment configuration
# Copy to .env and fill in every value. NEVER commit the real .env file.
# =============================================================================

# --- URLs ---------------------------------------------------------------------
# Public base URL of the signup frontend (no trailing slash).
# Used by the Telegram bot to build registration links:
#   {BASE_URL}/register?code=<token>
BASE_URL=https://signup.example.com

# Frontend -> backend API base. Leave empty for same-origin deployment (the
# bundled nginx proxies /api/v1 to the backend container). Only set this when
# the frontend is hosted separately from the backend.
VITE_API_BASE_URL=

# --- LLDAP (external server, not bundled) -------------------------------------
# ldaps://host:port for LDAPS, or ldap://host:port for StartTLS (attempted
# automatically). Plaintext LDAP is refused unless LDAP_ALLOW_INSECURE=true.
LDAP_URL=ldaps://lldap.example.com:6360
LDAP_ADMIN_DN=uid=admin,ou=people,dc=example,dc=com
LDAP_ADMIN_PASSWORD=change-me
LDAP_BASE_DN=dc=example,dc=com
# Optional: path (inside the backend container) to a CA bundle / PEM that
# signs the LLDAP certificate — internal CA or LLDAP's own self-signed cert.
# Mount it, e.g.:
#   volumes: ["./lldap-ca.pem:/lldap-ca.pem:ro"]  LDAP_CA_CERT=/lldap-ca.pem
# (Python's SSL_CERT_FILE env var works too.)
LDAP_CA_CERT=
# Dev/test only: allow plaintext ldap:// (e.g. containerized LLDAP in CI).
# NEVER enable in production.
LDAP_ALLOW_INSECURE=false
# LLDAP's GraphQL API — required for group membership (LLDAP's LDAP interface
# cannot modify groups). Derived from LDAP_URL (same host, port 17170) when
# empty. LLDAP_ADMIN_USER defaults to the uid in LDAP_ADMIN_DN.
LLDAP_HTTP_URL=
LLDAP_ADMIN_USER=

# --- Telegram bot --------------------------------------------------------------
# Token from @BotFather. Used by the bot service, and by the backend to send
# "<PLATFORM_NAME> account created: <name>" notifications (when TELEGRAM_ADMIN_IDS
# is also set on the backend).
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# Comma-separated Telegram user IDs allowed to use admin commands.
# (Find yours by messaging @userinfobot.)
TELEGRAM_ADMIN_IDS=123456789

# --- Platform identity ------------------------------------------------------------
# Name of your platform, shown to users ("Acme account created") and used in
# Telegram registration notifications. Empty = generic "Account created".
PLATFORM_NAME=

# --- Registration codes ---------------------------------------------------------
# Minutes until a registration code expires. 0 (default) = no time limit;
# codes are always single-use and can be revoked with /revoke.
CODE_EXPIRY_MINUTES=0
# Failed submission attempts against a single code before it is invalidated.
MAX_FAILED_ATTEMPTS=5

# --- Rate limiting (Flask-Limiter syntax) --------------------------------------
RATE_LIMIT_VALIDATE=20 per minute
RATE_LIMIT_SUBMIT=5 per minute

# --- Storage / uploads ----------------------------------------------------------
# Path inside the backend container (keep it on the SQLite volume).
DATABASE_PATH=/data/codes.db
MAX_UPLOAD_MB=2

# --- Secrets ---------------------------------------------------------------------
# Strong random values. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FLASK_SECRET_KEY=
# Shared secret between the bot and the backend /internal/ API.
# Generate the same way as FLASK_SECRET_KEY.
INTERNAL_API_KEY=

# --- CORS ------------------------------------------------------------------------
# Comma-separated list of allowed origins for the backend API.
# No wildcards in production. Leave empty for the default same-origin
# deployment (nginx proxies /api/v1 to the backend, no CORS needed).
# CORS_ALLOWED_ORIGINS=https://signup.example.com
CORS_ALLOWED_ORIGINS=

# --- Reverse proxy / ports ---------------------------------------------------------
# How many reverse proxies sit in front of the backend (1 = the bundled nginx).
# Must match your topology so rate limits see real client IPs.
PROXY_TRUSTED_COUNT=1
# Host port the frontend is published on by docker compose.
FRONTEND_PORT=8080
